//@version=6
// GENERATED by tools/build_indicator.py; edit the library/view sources.
indicator("Supply & Demand - HTF Structure", overlay = true, max_labels_count = 500)
// Replace username/version after publishing HTFStructure in TradingView.
import YOUR_TRADINGVIEW_USERNAME/HTFStructure/1 as structure

int leftBars = input.int(2, "Swing left bars (HTF candles)", minval = 1, maxval = 20)
int rightBars = input.int(2, "Swing confirmation bars (HTF candles)", minval = 1, maxval = 20, tooltip = "A high must remain a pivot through this many following source candles. Use 1 to include smaller one-candle pullbacks; 2 filters them out if the second candle exceeds the high. Highs and lows qualify independently. Changing this setting also changes structure and bias.")
string htf = input.timeframe("240", "Structure HTF")
bool showSwings = input.bool(true, "Show confirmed swing labels")
bool showBackground = input.bool(true, "Show HTF bias background")
string levelDisplay = input.string("Compact", "Swing level display", options = ["Compact", "Hidden", "Full history"], group = "Swing levels")
int levelLength = input.int(8, "Compact line length (chart bars)", minval = 1, maxval = 100, group = "Swing levels")
int levelOffset = input.int(3, "Right offset (chart bars)", minval = 1, maxval = 50, group = "Swing levels")
bool showLevelPrices = input.bool(true, "Show compact price labels", group = "Swing levels")

if not chart.is_standard or na(timeframe.in_seconds()) or timeframe.in_seconds(htf) < timeframe.in_seconds()
    runtime.error("Use standard time-based candles and select an HTF equal to or above the chart timeframe.")

// Offset every result in the source context BEFORE requesting with lookahead_on.
// This same policy is used on equal-timeframe charts for consistent timing.
[lastHigh, lastLow, bias, bullishBos, bearishBos, bullishChoch, bearishChoch, highText, lowText, sourceOpen, sourceClose, highPivotTime, lowPivotTime, sourceHigh, sourceLow] = request.security(syminfo.tickerid, htf, structure.confirmed(leftBars, rightBars), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
bool newSnapshot = not na(sourceOpen) and not na(sourceOpen[1]) and sourceOpen != sourceOpen[1]
// The source snapshot is already closed: draw its labels as soon as it arrives.
// Pine rollback recreates these drawings during the receiving realtime bar.
// Alerts still wait for the receiving chart candle to close.
bool drawSnapshot = newSnapshot
bool emit = newSnapshot and barstate.isconfirmed
if drawSnapshot and showSwings
    if highText != ""
        label.new(highPivotTime, lastHigh, htf + " " + highText, xloc = xloc.bar_time, tooltip = "Pivot confirmed at source close: " + str.format_time(sourceClose), style = label.style_label_down, color = color.red, textcolor = color.white)
    if lowText != ""
        label.new(lowPivotTime, lastLow, htf + " " + lowText, xloc = xloc.bar_time, tooltip = "Pivot confirmed at source close: " + str.format_time(sourceClose), style = label.style_label_up, color = color.green, textcolor = color.white)

// Preserve values in Data Window without drawing a historical staircase by default.
plot(levelDisplay == "Full history" ? lastHigh : na, "HTF swing high history", color = color.new(color.red, 35), style = plot.style_stepline)
plot(lastHigh, "HTF confirmed swing high", display = display.data_window)
plot(levelDisplay == "Full history" ? lastLow : na, "HTF swing low history", color = color.new(color.green, 35), style = plot.style_stepline)
plot(lastLow, "HTF confirmed swing low", display = display.data_window)

// Only two short current-level segments; never retain their historical trails.
var line highGuide = na
var line lowGuide = na
var label highGuideLabel = na
var label lowGuideLabel = na
if barstate.islast
    line.delete(highGuide)
    line.delete(lowGuide)
    label.delete(highGuideLabel)
    label.delete(lowGuideLabel)
    highGuide := na
    lowGuide := na
    highGuideLabel := na
    lowGuideLabel := na
    if levelDisplay == "Compact"
        int endBar = bar_index + levelOffset
        int startBar = math.max(0, endBar - levelLength)
        string levelHelp = "Latest confirmed HTF pivot reference. It may already have been broken; this is not a fresh zone or an entry signal."
        if not na(lastHigh)
            highGuide := line.new(startBar, lastHigh, endBar, lastHigh, color = color.new(color.red, 25), style = line.style_dashed, width = 1)
            if showLevelPrices
                highGuideLabel := label.new(endBar, lastHigh, "Swing high " + str.tostring(lastHigh, format.mintick), style = label.style_label_left, color = color.new(color.red, 85), textcolor = color.red, size = size.small, tooltip = levelHelp)
        if not na(lastLow)
            lowGuide := line.new(startBar, lastLow, endBar, lastLow, color = color.new(color.green, 25), style = line.style_dashed, width = 1)
            if showLevelPrices
                lowGuideLabel := label.new(endBar, lastLow, "Swing low " + str.tostring(lastLow, format.mintick), style = label.style_label_left, color = color.new(color.green, 85), textcolor = color.green, size = size.small, tooltip = levelHelp)
plot(bias, "HTF bias: bull 1 / bear -1 / transition 2 / neutral 0", display = display.data_window)
plot(sourceClose, "Source confirmation close timestamp", display = display.data_window)
color biasColor = bias == 1 ? color.green : bias == -1 ? color.red : bias == 2 ? color.orange : color.gray
bgcolor(showBackground and not na(bias) ? color.new(biasColor, 92) : na)
// Historical placement identifies the source candle; alerts still wait for chart close.
if drawSnapshot
    if bullishBos or bullishChoch
        label.new(sourceOpen, sourceLow, htf + (bullishBos ? " BOS" : " CHoCH"), xloc = xloc.bar_time, style = label.style_label_up, color = bullishBos ? color.green : color.orange, textcolor = color.white, tooltip = "Break confirmed at source close: " + str.format_time(sourceClose))
    if bearishBos or bearishChoch
        label.new(sourceOpen, sourceHigh, htf + (bearishBos ? " BOS" : " CHoCH"), xloc = xloc.bar_time, style = label.style_label_down, color = bearishBos ? color.red : color.orange, textcolor = color.white, tooltip = "Break confirmed at source close: " + str.format_time(sourceClose))
alertcondition(emit and (bullishBos or bearishBos), "Confirmed HTF BOS", "HTF continuation structure break confirmed.")
alertcondition(emit and (bullishChoch or bearishChoch), "Confirmed HTF CHoCH", "HTF opposing structure break confirmed; bias is transitional.")
