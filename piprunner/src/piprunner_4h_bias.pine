//@version=6
indicator("Piprunner MTF Structure • PROPOSED · UI 1.0.2", overlay = true, max_labels_count = 300, max_lines_count = 150, max_boxes_count = 30, max_bars_back = 200)
// Explicit output near the header; visible in Data Window only, never changes trading logic.
plot(close, title = "Source diagnostic close", display = display.data_window)

// Research indicator only. See docs/requirements.md Sections 3–5 and docs/4H_BIAS.md.
int leftBars = input.int(2, "4H pivot left bars", minval = 1, maxval = 20, group = "Structure — changes logic", display = display.none)
int rightBars = input.int(2, "4H pivot right bars", minval = 1, maxval = 20, group = "Structure — changes logic", display = display.none)
int oneLeft = input.int(2, "1H pivot left bars (proposed)", minval = 1, maxval = 20, group = "1H structure — changes logic", display = display.none)
int oneRight = input.int(2, "1H pivot right bars (proposed)", minval = 1, maxval = 20, group = "1H structure — changes logic", display = display.none)
bool show1H = input.bool(true, "Show 1H structure on 1H/15m charts", group = "1H learning — visuals only", display = display.none)
bool oneLevels = input.bool(true, "Current 1H high and low", group = "1H learning — visuals only", display = display.none)
bool oneBreaks = input.bool(true, "1H BOS / CHoCH", group = "1H learning — visuals only", display = display.none)
int oneHistory = input.int(2, "1H historical break lines", minval = 0, maxval = 20, group = "1H learning — visuals only", display = display.none)
int oneOffset = input.int(14, "1H current label offset (chart bars)", minval = 0, maxval = 40, group = "1H learning — visuals only", display = display.none)
color oneBull = input.color(color.blue, "1H bullish", group = "1H appearance", display = display.none)
color oneBear = input.color(color.orange, "1H bearish", group = "1H appearance", display = display.none)
color oneNeutral = input.color(color.silver, "1H neutral / unknown", group = "1H appearance", display = display.none)
int fifteenLeft = input.int(2, "15m pivot left bars (research)", minval = 1, maxval = 20, group = "15m structure — changes logic", display = display.none)
int fifteenRight = input.int(2, "15m pivot right bars (research)", minval = 1, maxval = 20, group = "15m structure — changes logic", display = display.none)
bool show15m = input.bool(true, "Show 15m structure on 15m charts", group = "15m learning — visuals only", display = display.none)
bool fifteenLevels = input.bool(true, "Current 15m high and low", group = "15m learning — visuals only", display = display.none)
bool fifteenBreaks = input.bool(true, "15m research BOS / CHoCH", group = "15m learning — visuals only", display = display.none)
int fifteenHistory = input.int(2, "15m historical break lines", minval = 0, maxval = 20, group = "15m learning — visuals only", display = display.none)
int fifteenOffset = input.int(22, "15m current label offset (chart bars)", minval = 0, maxval = 50, group = "15m learning — visuals only", display = display.none)
color fifteenBull = input.color(color.fuchsia, "15m bullish (violet family)", group = "15m appearance", display = display.none)
color fifteenBear = input.color(color.yellow, "15m bearish", group = "15m appearance", display = display.none)
color fifteenNeutral = input.color(color.gray, "15m neutral / unknown", group = "15m appearance", display = display.none)
string mode = input.string("Training", "Annotation mode", options = ["Training", "Guided", "Minimal", "Off"], group = "Learning — visuals only", display = display.none)
string drawingStyle = input.string("Horizontal lines", "Structure drawing style", options = ["Horizontal lines", "Legacy labels"], group = "Learning — visuals only", display = display.none)
bool swingNames = input.bool(true, "Temporary swing names: 4SH/4SL, 1SH/1SL, 15SH/15SL", group = "Learning — visuals only", display = display.none)
bool showLevels = input.bool(true, "Current 4H high and low levels", group = "Horizontal structure — visuals only", display = display.none)
bool showBreaks = input.bool(true, "Confirmed 4H BOS / CHoCH (proposed)", group = "Horizontal structure — visuals only", display = display.none)
string breakTextScale = input.string("Large", "BOS / CHoCH text size", options = ["Normal", "Large", "Huge"], group = "Horizontal structure — visuals only", display = display.none)
int retainedBreaks = input.int(3, "Historical break lines (0 = current levels only)", minval = 0, maxval = 20, group = "Horizontal structure — visuals only", display = display.none)
int levelLabelOffset = input.int(6, "Current label offset (chart bars)", minval = 0, maxval = 30, group = "Horizontal structure — visuals only", display = display.none)
int levelWidth = input.int(1, "Level line width", minval = 1, maxval = 3, group = "Horizontal structure — visuals only", display = display.none)
bool show4H = input.bool(true, "Show 4H annotations", group = "Learning — visuals only", display = display.none)
bool showPanel = input.bool(true, "Show checklist panel", group = "Learning — visuals only", display = display.none)
bool showOrigins = input.bool(true, "AN02 swing origin labels", group = "Learning — visuals only", display = display.none)
bool showConfirmations = input.bool(true, "AN02 confirmation markers", group = "Learning — visuals only", display = display.none)
bool showBiasEvents = input.bool(true, "AN03 bias change labels", group = "Learning — visuals only", display = display.none)
bool showProtection = input.bool(true, "AN04 protected level", group = "Learning — visuals only", display = display.none)
bool showBreachStatus = input.bool(true, "Explain live breach on protected 4H label", group = "Learning — visuals only", display = display.none)
bool showInvalidations = input.bool(true, "AN04 invalidation labels", group = "Learning — visuals only", display = display.none)
bool detailed = input.bool(true, "Detailed explanations", group = "Learning — visuals only", display = display.none)
string panelLayout = input.string("Summary", "Checklist layout", options = ["Summary", "Compact", "Full"], group = "Learning — visuals only", display = display.none)
bool showFutureRows = input.bool(false, "Expand future module checklist (Training)", group = "Learning — visuals only", display = display.none)
bool showDeveloping = input.bool(true, "Show developing-candle explanation", group = "Learning — visuals only", display = display.none)
float labelSpacing = input.float(0.5, "Label spacing (confirmed 4H range units)", minval = 0, maxval = 5, step = 0.1, group = "Learning — visuals only", display = display.none)
bool structureColors = input.bool(true, "Color HH/HL bullish and LH/LL bearish", group = "Appearance", display = display.none)
int panelTransparency = input.int(0, "Panel transparency", minval = 0, maxval = 80, group = "Appearance", display = display.none)
int retainedLabels = input.int(100, "Retained historical labels", minval = 10, maxval = 150, group = "Learning — visuals only", display = display.none)
string panelCorner = input.string("Top right", "Panel position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = "Learning — visuals only", display = display.none)
string labelScale = input.string("Small", "Text size", options = ["Small", "Normal", "Large"], group = "Learning — visuals only", display = display.none)
color bullColor = input.color(color.teal, "Bullish", group = "Appearance", display = display.none)
color bearColor = input.color(color.red, "Bearish", group = "Appearance", display = display.none)
color neutralColor = input.color(color.gray, "Neutral / unknown", group = "Appearance", display = display.none)

// Proposed detector thresholds: review against user-drawn course examples.
int baseBars = input.int(2, "Base candles (proposed)", minval=1, maxval=6, group="S/D detection — proposed", display = display.none)
float baseBodyMax = input.float(0.5, "Maximum base body/range", minval=0.05,maxval=1,step=0.05,group="S/D detection — proposed", display = display.none)
float baseATRMax = input.float(1.2, "Maximum full base range / ATR14",minval=0.1,maxval=5,step=0.1,group="S/D detection — proposed", display = display.none)
float departureATR = input.float(1.0,"Two-candle departure / ATR14",minval=0.1,maxval=5,step=0.1,group="S/D detection — proposed", display = display.none)
float departureBodyMin = input.float(0.5,"Minimum departure body/range",minval=0.1,maxval=1,step=0.05,group="S/D detection — proposed", display = display.none)
float sdBuffer = input.float(30,"Invalidation buffer % of full base range",minval=0,maxval=200,step=1,group="S/D lifecycle", display = display.none)
bool sdShow4 = input.bool(true,"Show 4H S/D",group="S/D display only", display = display.none)
bool sdShow1 = input.bool(true,"Show 1H S/D on 1H/15m",group="S/D display only", display = display.none)
bool sdShow15 = input.bool(false,"Show 15m S/D on 15m",group="S/D display only", display = display.none)
bool sdShowInvalid = input.bool(false,"Show latest invalidated zones",group="S/D display only", display = display.none)
bool sdShowInvalidation = input.bool(true,"Show buffered invalidation lines",group="S/D display only", display = display.none)
int sdOpacity = input.int(92,"Zone transparency",minval=70,maxval=100,group="S/D display only", display = display.none)
bool pinEnabled = input.bool(true,"Pin-bar candidate",group="1H SPA — proposed", display = display.none)
float pinRatio = input.float(2,"Pin rejection wick / body",minval=1,maxval=10,step=0.1,group="1H SPA — proposed", display = display.none)
float pinRange = input.float(0.6,"Pin rejection wick / range minimum",minval=0.1,maxval=0.95,step=0.05,group="1H SPA — proposed", display = display.none)
float pinOpposite = input.float(0.2,"Pin opposite wick / range maximum",minval=0,maxval=0.5,step=0.05,group="1H SPA — proposed", display = display.none)
float pinClose = input.float(0.35,"Pin close distance from rejection-opposite end / range",minval=0.05,maxval=0.5,step=0.05,group="1H SPA — proposed", display = display.none)
bool engulfEnabled = input.bool(true,"Engulfing candidate",group="1H SPA — proposed", display = display.none)
float engulfRatio = input.float(1.2,"Engulfing body / prior body minimum",minval=1,maxval=5,step=0.1,group="1H SPA — proposed", display = display.none)
float engulfBody = input.float(0.6,"Engulfing body / range minimum",minval=0.1,maxval=1,step=0.05,group="1H SPA — proposed", display = display.none)
bool piercingEnabled = input.bool(true,"Bullish piercing candidate",group="1H SPA — proposed", display = display.none)
bool darkCloudEnabled = input.bool(false,"Bearish dark-cloud counterpart (experimental)",group="1H SPA — proposed", display = display.none)
bool piercingGap = input.bool(false,"Require strict piercing / dark-cloud gap",group="1H SPA — proposed", display = display.none)
bool contactPrevious = input.bool(true,"Two-candle pattern: allow prior candle zone contact",group="1H SPA — proposed", display = display.none)
bool spaShow = input.bool(true,"Show 1H SPA research candidates",group="SPA display only", display = display.none)
int spaHistory = input.int(10,"Retained SPA labels",minval=1,maxval=30,group="SPA display only", display = display.none)

if not (timeframe.isminutes and (timeframe.multiplier == 15 or timeframe.multiplier == 60 or timeframe.multiplier == 240))
    runtime.error("Use a standard 15m, 1H or 4H chart for this first feature.")
if not chart.is_standard
    runtime.error("Use standard candles, not synthetic chart prices.")

// All persistent structural state lives in the requested 4H context.
// Every returned field is offset, paired with lookahead_on below: no developing HTF field leaks out.
f_snapshot(int pivotLeft, int pivotRight) =>
    var float hPrev = na
    var float hLast = na
    var float lPrev = na
    var float lLast = na
    var int hTime = na
    var int lTime = na
    var int state = 2 // 2 unknown, 0 neutral, 1 bullish, -1 bearish
    var float protection = na
    var int version = 0
    var string reason = "INSUFFICIENT_STRUCTURE"
    var bool qualityBlocked = false
    // Educational break detector is independent of bias classification. It does not change state.
    var int consumedHigh = na
    var int consumedLow = na
    bool valid = not na(open) and not na(high) and not na(low) and not na(close) and high >= math.max(open, close) and low <= math.min(open, close) and high >= low
    bool ph = bar_index >= pivotLeft + pivotRight
    bool pl = ph
    for i = 0 to pivotLeft + pivotRight
        if i != pivotRight
            ph := ph and not na(high[i]) and high[pivotRight] > high[i]
            pl := pl and not na(low[i]) and low[pivotRight] < low[i]
    bool dual = ph and pl
    if dual
        ph := false
        pl := false
    bool broken = (state == 1 and close < protection) or (state == -1 and close > protection)
    int previous = state
    float oldProtection = protection
    int breakCode = 0 // +/-1 BOS, +/-2 CHoCH, +/-3 unclassified break
    float breakLevel = na
    int breakOrigin = na
    if valid and not qualityBlocked
        if not na(hLast) and (na(consumedHigh) or consumedHigh != hTime) and close > hLast and close[1] <= hLast
            breakCode := previous == 1 ? 1 : previous == -1 ? 2 : 3
            breakLevel := hLast
            breakOrigin := hTime
            consumedHigh := hTime
        else if not na(lLast) and (na(consumedLow) or consumedLow != lTime) and close < lLast and close[1] >= lLast
            breakCode := previous == -1 ? -1 : previous == 1 ? -2 : -3
            breakLevel := lLast
            breakOrigin := lTime
            consumedLow := lTime
    float hp = na
    float lp = na
    int origin = na
    string hClass = ""
    string lClass = ""
    if not valid
        qualityBlocked := true
    if not qualityBlocked
        if ph
            hp := high[pivotRight]
            origin := time[pivotRight]
            hClass := na(hLast) ? "H" : hp > hLast ? "HH" : hp < hLast ? "LH" : "EH"
            hPrev := hLast
            hLast := hp
            hTime := origin
        if pl
            lp := low[pivotRight]
            origin := time[pivotRight]
            lClass := na(lLast) ? "L" : lp > lLast ? "HL" : lp < lLast ? "LL" : "EL"
            lPrev := lLast
            lLast := lp
            lTime := origin
        // Already broken at discovery: show consumed but never invent a delayed break event.
        if ph and close > hLast
            consumedHigh := hTime
        if pl and close < lLast
            consumedLow := lTime
    bool enough = not na(hPrev) and not na(lPrev)
    if qualityBlocked
        state := 2
        protection := na
        reason := "DATA_ERROR_RELOAD_REQUIRED"
    else if broken
        state := 0
        protection := na
        reason := previous == 1 ? "CLOSE_BELOW_PROTECTED_LOW" : "CLOSE_ABOVE_PROTECTED_HIGH"
    else if not enough
        state := 2
        protection := na
        reason := dual ? "AMBIGUOUS_DUAL_PIVOT" : "INSUFFICIENT_STRUCTURE"
    else if ph or pl or state == 2
        bool bull = hLast > hPrev and lLast > lPrev
        bool bear = hLast < hPrev and lLast < lPrev
        state := bull and close >= lLast ? 1 : bear and close <= hLast ? -1 : 0
        protection := state == 1 ? lLast : state == -1 ? hLast : na
        reason := state == 1 ? "HH_AND_HL" : state == -1 ? "LH_AND_LL" : bull or bear ? "ALREADY_INVALIDATED" : "MIXED_OR_EQUAL_STRUCTURE"
    // No new pivot after invalidation means no rearm: the consumed tuple is never reclassified.
    if previous != state or ph or pl or broken or (na(oldProtection) != na(protection))
        version += 1
    bool highUsed = not na(hTime) and consumedHigh == hTime
    bool lowUsed = not na(lTime) and consumedLow == lTime
    [state[1], protection[1], hPrev[1], hLast[1], lPrev[1], lLast[1], hTime[1], lTime[1], version[1], reason[1], hp[1], lp[1], origin[1], hClass[1], lClass[1], broken[1], dual[1], time_close[1], close[1], high[1], low[1], breakCode[1], breakLevel[1], breakOrigin[1], highUsed[1], lowUsed[1]]

[bias, protectedPrice, h0, h1, l0, l1, ht, lt, evidenceVersion, why, newHigh, newLow, pivotOrigin, highClass, lowClass, invalidated, ambiguous, confirmedAt, sourceClose, sourceHigh, sourceLow, breakCode, breakLevel, breakOrigin, highUsed, lowUsed] = request.security(syminfo.tickerid, "240", f_snapshot(leftBars, rightBars), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

f_state(int s) =>
    na(s) or s == 2 ? "UNKNOWN" : s == 1 ? "BULLISH" : s == -1 ? "BEARISH" : "NEUTRAL"
f_price(float p) =>
    na(p) ? "—" : str.tostring(p, format.mintick)
f_time(int t) =>
    na(t) ? "—" : str.format_time(t, "yyyy-MM-dd HH:mm", "UTC")
f_structure_color(string classification, bool isHigh) =>
    structureColors ? (classification == "HH" or classification == "HL" ? bullColor : classification == "LH" or classification == "LL" ? bearColor : neutralColor) : (isHigh ? bullColor : bearColor)

bool visible = mode != "Off" and show4H
bool training = mode == "Training"
bool expanded = training or mode == "Guided"
bool newSnapshot = not na(confirmedAt) and (na(confirmedAt[1]) or confirmedAt != confirmedAt[1])
bool changed = not na(bias) and (na(bias[1]) or bias != bias[1])
color biasColor = bias == 1 ? bullColor : bias == -1 ? bearColor : neutralColor
string textSize = labelScale == "Large" ? size.large : labelScale == "Normal" ? size.normal : size.small
string breakTextSize = breakTextScale == "Huge" ? size.huge : breakTextScale == "Normal" ? size.normal : size.large
var array<label> labels = array.new<label>()
var int pruned = 0
var int labelLane = 0
// Objects are created only after the confirmed snapshot becomes available on this chart.
if visible and newSnapshot and drawingStyle == "Legacy labels"
    // Fixed on publication using closed 4H prices; no live ATR or future repositioning.
    float gap = math.max(sourceHigh - sourceLow, syminfo.mintick * 10) * labelSpacing
    int lane = labelLane % 3
    labelLane += 1
    float upperY = sourceHigh + gap * (lane + 1)
    float lowerY = sourceLow - gap * (lane + 1)
    string timing = "\nOrigin UTC " + f_time(pivotOrigin) + "\nConfirmed UTC " + f_time(confirmedAt) + "\nPublished on chart UTC " + f_time(time)
    if training and showOrigins and not na(newHigh)
        array.push(labels, label.new(pivotOrigin, newHigh + gap, (swingNames ? "4SH/" + highClass : "4H " + highClass) + (detailed ? "\n" + f_price(newHigh) + " | confirmed later" : ""), xloc = xloc.bar_time, style = label.style_label_down, color = f_structure_color(highClass, true), textcolor = color.white, size = textSize, tooltip = "Pivot price " + f_price(newHigh) + timing))
    if training and showOrigins and not na(newLow)
        array.push(labels, label.new(pivotOrigin, newLow - gap, (swingNames ? "4SL/" + lowClass : "4H " + lowClass) + (detailed ? "\n" + f_price(newLow) + " | confirmed later" : ""), xloc = xloc.bar_time, style = label.style_label_up, color = f_structure_color(lowClass, false), textcolor = color.white, size = textSize, tooltip = "Pivot price " + f_price(newLow) + timing))
    if expanded and showConfirmations and (not na(newHigh) or not na(newLow))
        array.push(labels, label.new(time, not na(newHigh) ? upperY : lowerY, "4H " + (not na(newHigh) ? highClass : lowClass) + " CONFIRMED", xloc = xloc.bar_time, style = not na(newHigh) ? label.style_label_down : label.style_label_up, color = neutralColor, textcolor = color.white, size = textSize, tooltip = str.tostring(rightBars) + " right bars closed" + timing))
    if expanded and ((changed and showBiasEvents) or (invalidated and showInvalidations))
        array.push(labels, label.new(time, upperY + gap * 2, "4H " + f_state(bias), xloc = xloc.bar_time, style = label.style_label_down, color = biasColor, textcolor = color.white, size = textSize, tooltip = why + "\nBias is not an entry\nConfirmed UTC " + f_time(confirmedAt) + "\nPublished UTC " + f_time(time)))
    if training and ambiguous and showConfirmations
        array.push(labels, label.new(time, lowerY - gap * 2, "4H dual pivot discarded", xloc = xloc.bar_time, color = neutralColor, textcolor = color.white, size = textSize))
    while array.size(labels) > retainedLabels
        label.delete(array.shift(labels))
        pruned += 1

// Horizontal mode uses only two live levels plus a bounded number of completed break segments.
bool horizontal = visible and drawingStyle == "Horizontal lines"
var line highLine = na
var line lowLine = na
var label highLabel = na
var label lowLabel = na
var line protectionLine = na
var label protectionLabel = na
var array<line> breakLines = array.new<line>()
var array<label> breakLabels = array.new<label>()
if horizontal and expanded and newSnapshot and showBreaks and retainedBreaks > 0 and breakCode != 0
    color eventColor = breakCode > 0 ? bullColor : bearColor
    string eventName = math.abs(breakCode) == 1 ? "BOS" : math.abs(breakCode) == 2 ? "CHoCH" : "Break"
    string eventText = "4H " + eventName + (breakCode > 0 ? " ↑" : " ↓")
    array.push(breakLines, line.new(breakOrigin, breakLevel, confirmedAt, breakLevel, xloc = xloc.bar_time, color = eventColor, style = line.style_dashed, width = levelWidth))
    array.push(breakLabels, label.new(confirmedAt, breakLevel, eventText, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = eventColor, size = breakTextSize, tooltip = "PROPOSED 4H display classification\nLevel " + f_price(breakLevel) + "\nConfirmed UTC " + f_time(confirmedAt) + "\nPublished UTC " + f_time(time) + "\nNot a 15m entry CHoCH"))
    while array.size(breakLines) > retainedBreaks
        line.delete(array.shift(breakLines))
        label.delete(array.shift(breakLabels))

if barstate.islast
    line.delete(highLine)
    line.delete(lowLine)
    label.delete(highLabel)
    label.delete(lowLabel)
    line.delete(protectionLine)
    label.delete(protectionLabel)
    int endAt = time + int(timeframe.in_seconds() * 1000) * levelLabelOffset
    if horizontal and showLevels and not na(h1) and not na(ht)
        string highName = na(h0) ? "H" : h1 > h0 ? "HH" : h1 < h0 ? "LH" : "EH"
        bool isProtected = showProtection and protectedPrice == h1
        string protectionStatus = isProtected and showBreachStatus and close > h1 ? " · breached, await 4H close" : isProtected ? " · protected" : highUsed ? " · broken" : " · unbroken"
        color c = f_structure_color(highName, true)
        highLine := line.new(ht, h1, endAt, h1, xloc = xloc.bar_time, color = c, width = isProtected ? 2 : levelWidth, style = highUsed ? line.style_dotted : line.style_solid)
        highLabel := label.new(endAt, h1, (swingNames ? "4SH/" + highName : "4H " + highName) + " " + f_price(h1) + protectionStatus, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = textSize, tooltip = "4H " + highName + "; confirmed swing high, not a 1H/15m swing.\nOrigin UTC " + f_time(ht) + "\nBreached = live chart price beyond protection; confirmed bias unchanged.\nSolid = unbroken; dotted = consumed by confirmed close.")
    if horizontal and showLevels and not na(l1) and not na(lt)
        string lowName = na(l0) ? "L" : l1 > l0 ? "HL" : l1 < l0 ? "LL" : "EL"
        bool isProtected = showProtection and protectedPrice == l1
        string protectionStatus = isProtected and showBreachStatus and close < l1 ? " · breached, await 4H close" : isProtected ? " · protected" : lowUsed ? " · broken" : " · unbroken"
        color c = f_structure_color(lowName, false)
        lowLine := line.new(lt, l1, endAt, l1, xloc = xloc.bar_time, color = c, width = isProtected ? 2 : levelWidth, style = lowUsed ? line.style_dotted : line.style_solid)
        lowLabel := label.new(endAt, l1, (swingNames ? "4SL/" + lowName : "4H " + lowName) + " " + f_price(l1) + protectionStatus, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = textSize, tooltip = "4H " + lowName + "; confirmed swing low, not a 1H/15m swing.\nOrigin UTC " + f_time(lt) + "\nBreached = live chart price beyond protection; confirmed bias unchanged.\nSolid = unbroken; dotted = consumed by confirmed close.")
    if horizontal and showProtection and not na(protectedPrice) and (not showLevels or (protectedPrice != h1 and protectedPrice != l1))
        protectionLine := line.new(confirmedAt, protectedPrice, endAt, protectedPrice, xloc = xloc.bar_time, color = biasColor, width = 2)
        protectionLabel := label.new(endAt, protectedPrice, "4H protected " + f_price(protectedPrice), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = biasColor, size = textSize)

plot(visible and showProtection and drawingStyle == "Legacy labels" ? protectedPrice : na, "4H protected level", color = biasColor, linewidth = 2, style = plot.style_linebr)
// Exportable diagnostics intentionally remain independent of visual presets.
plot(bias, "Audit bias 2 unknown 0 neutral 1 bull -1 bear", display = display.data_window)
plot(evidenceVersion, "Audit evidence version", display = display.data_window)
plot(confirmedAt, "Audit 4H confirmation epoch ms", display = display.data_window)
plot(protectedPrice, "Audit protected price", display = display.data_window)
plot(h1, "Audit latest high", display = display.data_window)
plot(l1, "Audit latest low", display = display.data_window)

// Independent 1H context. Never request 1H via request.security() on a 4H chart:
// it would collapse several intrabars and could miss structure events.
bool supports1H = timeframe.in_seconds() <= 3600
int oneBias = na
float oneProtection = na
int oneConfirmed = na
float oneHigh = na
float oneLow = na
var array<line> oneLines = array.new<line>()
var array<label> oneLabels = array.new<label>()
var line oneHighLine = na
var line oneLowLine = na
var label oneHighLabel = na
var label oneLowLabel = na
if supports1H
    [s, p, hPrev1, hLast1, lPrev1, lLast1, hTime1, lTime1, v, reason1, hp1, lp1, origin1, hc1, lc1, broken1, dual1, at1, close1, hi1, lo1, code1, level1, reference1, usedH1, usedL1] = request.security(syminfo.tickerid, "60", f_snapshot(oneLeft, oneRight), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    oneBias := s
    oneProtection := p
    oneConfirmed := at1
    oneHigh := hLast1
    oneLow := lLast1
    bool oneVisible = mode != "Off" and show1H
    bool oneNew = not na(at1) and (na(at1[1]) or at1 != at1[1])
    if oneVisible and expanded and oneBreaks and oneHistory > 0 and oneNew and code1 != 0
        color c = code1 > 0 ? oneBull : oneBear
        string title = "1H " + (math.abs(code1) == 1 ? "BOS" : math.abs(code1) == 2 ? "CHoCH" : "Break") + (code1 > 0 ? " ↑" : " ↓")
        array.push(oneLines, line.new(reference1, level1, at1, level1, xloc = xloc.bar_time, color = c, style = line.style_dashed, width = levelWidth))
        array.push(oneLabels, label.new(at1, level1, title, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = breakTextSize, tooltip = "PROPOSED 1H structure only; P2/SPA setup not qualified\nLevel " + f_price(level1) + "\nConfirmed UTC " + f_time(at1) + "\nPublished UTC " + f_time(time)))
        while array.size(oneLines) > oneHistory
            line.delete(array.shift(oneLines))
            label.delete(array.shift(oneLabels))
    if barstate.islast
        line.delete(oneHighLine)
        line.delete(oneLowLine)
        label.delete(oneHighLabel)
        label.delete(oneLowLabel)
        int end1 = time + int(timeframe.in_seconds() * 1000) * oneOffset
        if oneVisible and oneLevels and not na(hLast1)
            string name = na(hPrev1) ? "H" : hLast1 > hPrev1 ? "HH" : hLast1 < hPrev1 ? "LH" : "EH"
            color c = name == "HH" ? oneBull : name == "LH" ? oneBear : oneNeutral
            oneHighLine := line.new(hTime1, hLast1, end1, hLast1, xloc = xloc.bar_time, color = c, style = usedH1 ? line.style_dotted : line.style_solid, width = 1)
            oneHighLabel := label.new(end1, hLast1, (swingNames ? "1SH/" + name : "1H " + name) + " " + f_price(hLast1) + (usedH1 ? " · broken" : " · unbroken"), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = textSize, tooltip = "1H " + name + "; setup still UNDEFINED\nOrigin UTC " + f_time(hTime1))
        if oneVisible and oneLevels and not na(lLast1)
            string name = na(lPrev1) ? "L" : lLast1 > lPrev1 ? "HL" : lLast1 < lPrev1 ? "LL" : "EL"
            color c = name == "HL" ? oneBull : name == "LL" ? oneBear : oneNeutral
            oneLowLine := line.new(lTime1, lLast1, end1, lLast1, xloc = xloc.bar_time, color = c, style = usedL1 ? line.style_dotted : line.style_solid, width = 1)
            oneLowLabel := label.new(end1, lLast1, (swingNames ? "1SL/" + name : "1H " + name) + " " + f_price(lLast1) + (usedL1 ? " · broken" : " · unbroken"), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = textSize, tooltip = "1H " + name + "; setup still UNDEFINED\nOrigin UTC " + f_time(lTime1))

plot(oneBias, "Audit 1H structure state", display = display.data_window)
plot(oneProtection, "Audit 1H structural protection", display = display.data_window)
plot(oneConfirmed, "Audit 1H confirmation epoch ms", display = display.data_window)
plot(oneHigh, "Audit 1H latest high", display = display.data_window)
plot(oneLow, "Audit 1H latest low", display = display.data_window)

// Independent 15m research layer: available only on the 15m chart.
bool supports15m = timeframe.in_seconds() == 900
int fifteenBias = na
float fifteenProtection = na
int fifteenConfirmed = na
float fifteenHigh = na
float fifteenLow = na
var array<line> fifteenLines = array.new<line>()
var array<label> fifteenLabels = array.new<label>()
var line fifteenHighLine = na
var line fifteenLowLine = na
var label fifteenHighLabel = na
var label fifteenLowLabel = na
if supports15m
    [s, p, hPrev1, hLast1, lPrev1, lLast1, hTime1, lTime1, v, reason1, hp1, lp1, origin1, hc1, lc1, broken1, dual1, at1, close1, hi1, lo1, code1, level1, reference1, usedH1, usedL1] = request.security(syminfo.tickerid, "15", f_snapshot(fifteenLeft, fifteenRight), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
    fifteenBias := s
    fifteenProtection := p
    fifteenConfirmed := at1
    fifteenHigh := hLast1
    fifteenLow := lLast1
    bool fifteenVisible = mode != "Off" and show15m
    bool fifteenNew = not na(at1) and (na(at1[1]) or at1 != at1[1])
    if fifteenVisible and expanded and fifteenBreaks and fifteenHistory > 0 and fifteenNew and code1 != 0
        color c = code1 > 0 ? fifteenBull : fifteenBear
        string title = "15m " + (math.abs(code1) == 1 ? "BOS" : math.abs(code1) == 2 ? "CHoCH" : "Break") + (code1 > 0 ? " ↑" : " ↓")
        array.push(fifteenLines, line.new(reference1, level1, at1, level1, xloc = xloc.bar_time, color = c, style = line.style_dashed, width = levelWidth))
        array.push(fifteenLabels, label.new(at1, level1, title, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = breakTextSize, tooltip = "PROPOSED 15m structure only; Not the qualified End-of-P2 entry sequence\nLevel " + f_price(level1) + "\nConfirmed UTC " + f_time(at1) + "\nPublished UTC " + f_time(time)))
        while array.size(fifteenLines) > fifteenHistory
            line.delete(array.shift(fifteenLines))
            label.delete(array.shift(fifteenLabels))
    if barstate.islast
        line.delete(fifteenHighLine)
        line.delete(fifteenLowLine)
        label.delete(fifteenHighLabel)
        label.delete(fifteenLowLabel)
        int end1 = time + int(timeframe.in_seconds() * 1000) * fifteenOffset
        if fifteenVisible and fifteenLevels and not na(hLast1)
            string name = na(hPrev1) ? "H" : hLast1 > hPrev1 ? "HH" : hLast1 < hPrev1 ? "LH" : "EH"
            color c = name == "HH" ? fifteenBull : name == "LH" ? fifteenBear : fifteenNeutral
            fifteenHighLine := line.new(hTime1, hLast1, end1, hLast1, xloc = xloc.bar_time, color = c, style = usedH1 ? line.style_dotted : line.style_solid, width = 1)
            fifteenHighLabel := label.new(end1, hLast1, (swingNames ? "15SH/" + name : "15m " + name) + " " + f_price(hLast1) + (usedH1 ? " · broken" : " · unbroken"), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = textSize, tooltip = "15m " + name + "; entry sequence still UNDEFINED\nOrigin UTC " + f_time(hTime1))
        if fifteenVisible and fifteenLevels and not na(lLast1)
            string name = na(lPrev1) ? "L" : lLast1 > lPrev1 ? "HL" : lLast1 < lPrev1 ? "LL" : "EL"
            color c = name == "HL" ? fifteenBull : name == "LL" ? fifteenBear : fifteenNeutral
            fifteenLowLine := line.new(lTime1, lLast1, end1, lLast1, xloc = xloc.bar_time, color = c, style = usedL1 ? line.style_dotted : line.style_solid, width = 1)
            fifteenLowLabel := label.new(end1, lLast1, (swingNames ? "15SL/" + name : "15m " + name) + " " + f_price(lLast1) + (usedL1 ? " · broken" : " · unbroken"), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = c, size = textSize, tooltip = "15m " + name + "; entry sequence still UNDEFINED\nOrigin UTC " + f_time(lTime1))

plot(fifteenBias, "Audit 15m structure state", display = display.data_window)
plot(fifteenProtection, "Audit 15m structural protection", display = display.data_window)
plot(fifteenConfirmed, "Audit 15m confirmation epoch ms", display = display.data_window)
plot(fifteenHigh, "Audit 15m latest high", display = display.data_window)
plot(fifteenLow, "Audit 15m latest low", display = display.data_window)

// Zones and SPA research implementation. Defaults are proposals; no order generation.
type SDState
    float dTop
    float dLow
    float dInvalid
    int dOrigin
    int dCreated
    bool dActive
    int dEnded
    float sTop
    float sLow
    float sInvalid
    int sOrigin
    int sCreated
    bool sActive
    int sEnded
    int asOf

f_sd() =>
    var float dt = na
    var float dl = na
    var float di = na
    var int dor = na
    var int dc = na
    var bool da = false
    var int de = na
    var float st = na
    var float sl = na
    var float si = na
    var int sor = na
    var int sc = na
    var bool sa = false
    var int se = na
    // Every call runs in the zone's OWN timeframe. Wicks never retire a zone.
    if da and close < di
        da := false
        de := time_close
    if sa and close > si
        sa := false
        se := time_close
    float atr = ta.atr(14)
    float bh = na
    float bl = na
    float bodyTop = na
    float bodyLow = na
    bool baseOK = bar_index >= baseBars + 15
    for i = 2 to baseBars + 1
        float r = high[i] - low[i]
        baseOK := baseOK and r > 0 and math.abs(close[i] - open[i]) <= r * baseBodyMax
        bh := na(bh) ? high[i] : math.max(bh, high[i])
        bl := na(bl) ? low[i] : math.min(bl, low[i])
        bodyTop := na(bodyTop) ? math.max(open[i], close[i]) : math.max(bodyTop, math.max(open[i], close[i]))
        bodyLow := na(bodyLow) ? math.min(open[i], close[i]) : math.min(bodyLow, math.min(open[i], close[i]))
    float r0 = high - low
    float r1 = high[1] - low[1]
    bool departureBodies = r0 > 0 and r1 > 0 and math.abs(close-open) >= r0 * departureBodyMin and math.abs(close[1]-open[1]) >= r1 * departureBodyMin
    bool compact = baseOK and not na(atr[2]) and bh > bl and bh - bl <= atr[2] * baseATRMax
    bool up = compact and departureBodies and close[1] > open[1] and close > open and close > bh and close - open[1] >= atr[2] * departureATR
    bool down = compact and departureBodies and close[1] < open[1] and close < open and close < bl and open[1] - close >= atr[2] * departureATR
    // Latest confirmed candidate per side replaces the older side reference; never redraw its bounds.
    if up and bodyTop > bl
        dt := bodyTop
        dl := bl
        di := math.floor(math.round((bl - (bh-bl) * sdBuffer / 100.0) / syminfo.mintick, 8)) * syminfo.mintick
        dor := time[baseBars+1]
        dc := time_close
        da := true
        de := na
    if down and bh > bodyLow
        st := bh
        sl := bodyLow
        si := math.ceil(math.round((bh + (bh-bl) * sdBuffer / 100.0) / syminfo.mintick, 8)) * syminfo.mintick
        sor := time[baseBars+1]
        sc := time_close
        sa := true
        se := na
    SDState.new(dt[1], dl[1], di[1], dor[1], dc[1], da[1], de[1], st[1], sl[1], si[1], sor[1], sc[1], sa[1], se[1], time_close[1])

type SPAState
    float hi
    float lo
    float lastHi
    float lastLo
    float price
    float bodyTop
    float bodyLow
    int opened
    int lastOpened
    int confirmed
    bool bullPin
    bool bearPin
    bool bullEngulf
    bool bearEngulf
    bool bullPierce
    bool bearCloud

f_spa() =>
    float r = high-low
    float b = math.abs(close-open)
    float prevB = math.abs(close[1]-open[1])
    float upper = high-math.max(open,close)
    float lower = math.min(open,close)-low
    bool good = r > 0 and b > 0
    bool bp = pinEnabled and good and lower >= pinRatio*b and lower >= pinRange*r and upper <= pinOpposite*r and close >= low+(1-pinClose)*r
    bool sp = pinEnabled and good and upper >= pinRatio*b and upper >= pinRange*r and lower <= pinOpposite*r and close <= low+pinClose*r
    bool strong = good and prevB > 0 and b >= engulfRatio*prevB and b >= engulfBody*r
    bool be = engulfEnabled and strong and close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
    bool se = engulfEnabled and strong and close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
    bool gapUp = piercingGap ? open < low[1] : open <= close[1]
    bool gapDown = piercingGap ? open > high[1] : open >= close[1]
    bool bi = piercingEnabled and good and close[1] < open[1] and close > open and gapUp and close > (open[1]+close[1])/2 and close < open[1]
    bool si = darkCloudEnabled and good and close[1] > open[1] and close < open and gapDown and close < (open[1]+close[1])/2 and close > open[1]
    SPAState.new(high[1],low[1],high[2],low[2],close[1],math.max(open[1],close[1]),math.min(open[1],close[1]),time[1],time[2],time_close[1],bp[1],sp[1],be[1],se[1],bi[1],si[1])

SDState sd4 = request.security(syminfo.tickerid, "240", f_sd(), lookahead = barmerge.lookahead_on)
SDState sd1 = na
SDState sd15 = na
SPAState spa = na
if supports1H
    sd1 := request.security(syminfo.tickerid, "60", f_sd(), lookahead = barmerge.lookahead_on)
    spa := request.security(syminfo.tickerid, "60", f_spa(), lookahead = barmerge.lookahead_on)
if supports15m
    sd15 := request.security(syminfo.tickerid, "15", f_sd(), lookahead = barmerge.lookahead_on)

// Contact must occur AFTER zone creation. Invalidated zones cannot qualify a pattern.
f_contact(SDState z, SPAState candle, bool demand, bool previousCandle, bool wickOnly) =>
    bool hit = false
    if not na(z) and not na(candle)
        float top = demand ? z.dTop : z.sTop
        float bottom = demand ? z.dLow : z.sLow
        bool active = demand ? z.dActive : z.sActive
        int created = demand ? z.dCreated : z.sCreated
        int opened = previousCandle ? candle.lastOpened : candle.opened
        float hi = previousCandle ? candle.lastHi : candle.hi
        float lo = previousCandle ? candle.lastLo : candle.lo
        if wickOnly and not previousCandle
            hi := demand ? candle.bodyLow : candle.hi
            lo := demand ? candle.lo : candle.bodyTop
        hit := active and not na(created) and created <= opened and lo <= top and hi >= bottom
    hit

var array<box> sdBoxes = array.new<box>()
var array<line> sdLines = array.new<line>()
var array<label> sdLabels = array.new<label>()
f_draw_sd(SDState z, string tf, color demandColor, color supplyColor, bool enabled) =>
    if not na(z) and enabled and mode != "Off"
        for side = 0 to 1
            bool demand = side == 0
            bool active = demand ? z.dActive : z.sActive
            float top = demand ? z.dTop : z.sTop
            float bottom = demand ? z.dLow : z.sLow
            float invalid = demand ? z.dInvalid : z.sInvalid
            int origin = demand ? z.dOrigin : z.sOrigin
            int ended = demand ? z.dEnded : z.sEnded
            int created = demand ? z.dCreated : z.sCreated
            color c = active ? (demand ? demandColor : supplyColor) : color.gray
            if not na(origin) and (active or sdShowInvalid)
                int right = active ? time : ended
                string name = tf + (demand ? " Demand" : " Supply") + (active ? " · proposed" : " · INVALIDATED")
                array.push(sdBoxes, box.new(origin,top,right,bottom,xloc=xloc.bar_time,border_color=c,bgcolor=color.new(c,sdOpacity)))
                array.push(sdLabels,label.new(right,top,name,xloc=xloc.bar_time,style=label.style_label_left,color=color.new(color.black,100),textcolor=c,size=textSize,tooltip="Created UTC " + f_time(created) + "\nOwn-TF close invalidation " + f_price(invalid) + "\nBuffer " + str.tostring(sdBuffer) + "% of full base range\nLatest candidate per side only"))
                if sdShowInvalidation
                    array.push(sdLines,line.new(origin,invalid,right,invalid,xloc=xloc.bar_time,color=c,style=line.style_dotted))
                    array.push(sdLabels,label.new(right,invalid,tf + " close invalid " + f_price(invalid),xloc=xloc.bar_time,style=label.style_label_left,color=color.new(color.black,100),textcolor=c,size=textSize))
if barstate.islast
    while array.size(sdBoxes) > 0
        box.delete(array.pop(sdBoxes))
    while array.size(sdLines) > 0
        line.delete(array.pop(sdLines))
    while array.size(sdLabels) > 0
        label.delete(array.pop(sdLabels))
    f_draw_sd(sd4,"4H",bullColor,bearColor,sdShow4)
    f_draw_sd(sd1,"1H",oneBull,oneBear,sdShow1)
    f_draw_sd(sd15,"15m",fifteenBull,fifteenBear,sdShow15)

int spaCandidate = 0
string spaPatterns = ""
string spaLocation = ""
if not na(spa)
    bool dCurrent = f_contact(sd4,spa,true,false,false) or f_contact(sd1,spa,true,false,false)
    bool sCurrent = f_contact(sd4,spa,false,false,false) or f_contact(sd1,spa,false,false,false)
    bool dPrevious = f_contact(sd4,spa,true,true,false) or f_contact(sd1,spa,true,true,false)
    bool sPrevious = f_contact(sd4,spa,false,true,false) or f_contact(sd1,spa,false,true,false)
    bool longPin = spa.bullPin and (f_contact(sd4,spa,true,false,true) or f_contact(sd1,spa,true,false,true))
    bool shortPin = spa.bearPin and (f_contact(sd4,spa,false,false,true) or f_contact(sd1,spa,false,false,true))
    bool longEngulf = spa.bullEngulf and (dCurrent or (contactPrevious and dPrevious))
    bool shortEngulf = spa.bearEngulf and (sCurrent or (contactPrevious and sPrevious))
    bool longPierce = spa.bullPierce and (dCurrent or (contactPrevious and dPrevious))
    bool shortCloud = spa.bearCloud and (sCurrent or (contactPrevious and sPrevious))
    if bias == 1 and (longPin or longEngulf or longPierce)
        spaCandidate := 1
        spaPatterns := (longPin ? "Pin " : "") + (longEngulf ? "Engulf " : "") + (longPierce ? "Piercing" : "")
        spaLocation := "Demand"
    else if bias == -1 and (shortPin or shortEngulf or shortCloud)
        spaCandidate := -1
        spaPatterns := (shortPin ? "Pin " : "") + (shortEngulf ? "Engulf " : "") + (shortCloud ? "Dark cloud" : "")
        spaLocation := "Supply"
var array<label> spaLabels = array.new<label>()
int spaClosed = not na(spa) ? spa.confirmed : na
if not na(spa)
    bool spaNew = not na(spaClosed) and (na(spaClosed[1]) or spaClosed != spaClosed[1])
    if spaCandidate != 0 and spaNew and mode != "Off" and spaShow
        array.push(spaLabels,label.new(time,spa.price,"1H SPA candidate " + (spaCandidate == 1 ? "↑ " : "↓ ") + spaPatterns,xloc=xloc.bar_time,style=spaCandidate == 1 ? label.style_label_up : label.style_label_down,color=spaCandidate == 1 ? oneBull : oneBear,textcolor=color.white,size=textSize,tooltip="PROPOSED strength/contact rules\n" + spaLocation + " contact; 4H direction respected\nConfirmed UTC " + f_time(spa.confirmed) + "\nNo entry: 15m sequence still required; S/R branch not implemented"))
        while array.size(spaLabels) > spaHistory
            label.delete(array.shift(spaLabels))
plot(spaCandidate,"Audit 1H SPA research candidate",display=display.data_window)
plot(sd4.dActive ? sd4.dInvalid : na,"Audit 4H demand invalidation",display=display.data_window)
plot(sd4.sActive ? sd4.sInvalid : na,"Audit 4H supply invalidation",display=display.data_window)


string corner = panelCorner == "Top left" ? position.top_left : panelCorner == "Bottom left" ? position.bottom_left : panelCorner == "Bottom right" ? position.bottom_right : position.top_right
var table panel = table.new(corner, 2, 23, border_width = 1)
f_row(int row, string title, string value, color c) =>
    table.cell(panel, 0, row, title, text_color = color.white, bgcolor = color.new(color.black, panelTransparency), text_size = textSize, text_halign = text.align_left)
    table.cell(panel, 1, row, value, text_color = color.white, bgcolor = color.new(c, panelTransparency), text_size = textSize, text_halign = text.align_left)
if barstate.islast
    table.clear(panel, 0, 0, 1, 22)
    if mode != "Off" and showPanel
        f_row(0, "4H · PROPOSED · UI 1.0.2", f_state(bias), biasColor)
        string alignment = oneBias == bias and (bias == 1 or bias == -1) ? " · aligned" : (oneBias == 1 or oneBias == -1) and (bias == 1 or bias == -1) ? " · opposed" : " · no directional alignment"
        f_row(1, "1H structure · P2 not qualified", supports1H ? f_state(oneBias) + alignment : "View 1H/15m · hidden on 4H", oneBias == 1 ? oneBull : oneBias == -1 ? oneBear : oneNeutral)
        bool threeAligned = (bias == 1 or bias == -1) and oneBias == bias and fifteenBias == bias
        f_row(2, "15m research · entry NOT qualified", supports15m ? f_state(fifteenBias) + (threeAligned ? " · 3TF aligned, no entry" : " · entry rules pending") : "View 15m · hidden here", fifteenBias == 1 ? fifteenBull : fifteenBias == -1 ? fifteenBear : fifteenNeutral)
        if expanded and panelLayout == "Full"
            f_row(3, "AN01 Feed / tick / timezone", syminfo.tickerid + " / " + f_price(syminfo.mintick) + " / " + syminfo.timezone, neutralColor)
            f_row(4, "AN01 Confirmed 4H close UTC", f_time(confirmedAt), neutralColor)
            f_row(5, "AN02 High pair", f_price(h0) + " → " + f_price(h1), neutralColor)
            f_row(6, "AN02 Low pair", f_price(l0) + " → " + f_price(l1), neutralColor)
            f_row(7, "AN03 Reason", why, biasColor)
            f_row(8, "AN04 Protection", f_price(protectedPrice), biasColor)
            f_row(9, "AN02 Latest origins UTC", "H " + f_time(ht) + "\nL " + f_time(lt), neutralColor)
            f_row(10, "History", str.tostring(array.size(labels)) + " labels; " + str.tostring(pruned) + " pruned", neutralColor)
        if expanded and panelLayout == "Compact"
            f_row(3, "4H confirmed UTC", f_time(confirmedAt), neutralColor)
            f_row(4, "High pair", f_price(h0) + " → " + f_price(h1), neutralColor)
            f_row(5, "Low pair", f_price(l0) + " → " + f_price(l1), neutralColor)
            f_row(6, "Protection", f_price(protectedPrice), biasColor)
            f_row(7, "Reason", why, biasColor)
            f_row(8, "Later modules", "UNDEFINED / not built · no orders", neutralColor)
        if training and showFutureRows
            f_row(11, "AN05–06 4H zones / SPA", "Proposed zones + 1H SPA candidates", neutralColor)
            f_row(12, "AN07 1H P2 setup", "Research SPA only · see setup panel", neutralColor)
            f_row(13, "AN08 15m CHoCH", "Research labels only · setup UNDEFINED", neutralColor)
            f_row(14, "AN09 Swing break", "WAITING for qualified CHoCH sequence", neutralColor)
            f_row(15, "AN10 Retest", "WAITING for swing break module", neutralColor)
            f_row(16, "AN11–12 Signal / entry / expiry", "WAITING / no orders", neutralColor)
            f_row(17, "AN13–15 Risk / TP1 / runner", "UNDEFINED / not implemented", neutralColor)
            f_row(18, "AN16 EMA36/100", "DISABLED OPTIONAL / not built", neutralColor)
            f_row(19, "AN17 Williams Fractals 15m", "DISABLED OPTIONAL / not built", neutralColor)
            f_row(20, "AN18 Lifecycle", "Structure events only; no entry signals", neutralColor)
        if showDeveloping
            // Current chart price is explanatory only, never input to f_snapshot().
            bool beyond = (bias == -1 and close > protectedPrice) or (bias == 1 and close < protectedPrice)
            string liveText = beyond ? "Price beyond level; WAIT for 4H close" : "Only a closed 4H break invalidates bias"
            int statusRow = training and showFutureRows ? 21 : expanded ? (panelLayout == "Full" ? 11 : 9) : 3
            f_row(statusRow, "4H rule · live price info", liveText, neutralColor)
            if expanded
                f_row(statusRow + 1, "Scheduled 4H close UTC", f_time(time_close("240")), neutralColor)

var table setupPanel = table.new(position.bottom_left,2,3,border_width=1)
if barstate.islast
    table.clear(setupPanel,0,0,1,2)
    if mode != "Off" and showPanel
        table.cell(setupPanel,0,0,"S/D + SPA · RESEARCH",text_color=color.white,bgcolor=color.black,text_size=textSize)
        table.cell(setupPanel,1,0,"No entry orders",text_color=color.white,bgcolor=color.black,text_size=textSize)
        table.cell(setupPanel,0,1,"1H latest candle",text_color=color.white,bgcolor=color.black,text_size=textSize)
        table.cell(setupPanel,1,1,not supports1H ? "View 1H/15m" : spaCandidate != 0 ? "Candidate: " + spaPatterns : "No HTF-aligned S/D SPA",text_color=color.white,bgcolor=color.black,text_size=textSize)
        table.cell(setupPanel,0,2,"Remaining gates",text_color=color.white,bgcolor=color.black,text_size=textSize)
        table.cell(setupPanel,1,2,"S/R branch + 15m entry sequence pending",text_color=color.white,bgcolor=color.black,text_size=textSize)
// END OF COMPLETE PIPRUNNER SCRIPT UI 1.0.2
